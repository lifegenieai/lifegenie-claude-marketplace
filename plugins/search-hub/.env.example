# search-hub API keys. Copy to ~/.search-hub/.env (or run: bun tools/search.ts --setup)
# Any provider whose key is blank is skipped. process.env overrides this file.

# Tavily: free tier (1000 credits/mo)   https://app.tavily.com/
TAVILY_API_KEY=

# Perplexity: paid, no free tier          https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Exa: free tier available               https://dashboard.exa.ai/
EXA_API_KEY=

# Gemini: free tier grounding allowance   https://aistudio.google.com/apikey
GEMINI_API_KEY=

